<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Adapted from EverythingToolbar Win11 Light tokens (MIT © 2023 Stephan Rumswinkel). See ATTRIBUTION.md. -->

  <!-- Widget surface tokens (Windows 11 Light Taskbar Button Hover & Pressed) -->
  <SolidColorBrush x:Key="WidgetBackground" Color="#01ffffff" />
  <SolidColorBrush x:Key="WidgetBackgroundHover" Color="#70ffffff" />
  <SolidColorBrush x:Key="WidgetBackgroundPressed" Color="#46ffffff" />
  <SolidColorBrush x:Key="WidgetBorderHover" Color="#14000000" />
  <SolidColorBrush x:Key="WidgetBorderPressed" Color="#0a000000" />
  <SolidColorBrush x:Key="WidgetForeground" Color="#1a1a1a" />
  <SolidColorBrush x:Key="WidgetForegroundHover" Color="#000000" />
  <CornerRadius x:Key="WidgetCornerRadius">4</CornerRadius>
  <FontFamily x:Key="WidgetFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <sys:Double x:Key="WidgetFontSize">12</sys:Double>
  <FontWeight x:Key="WidgetFontWeight">Normal</FontWeight>

  <!-- ToolTip tokens (Windows 11 Fluent Light) -->
  <SolidColorBrush x:Key="ToolTipBackground" Color="#f9f9f9" />
  <SolidColorBrush x:Key="ToolTipBorder" Color="#e5e5e5" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="#1a1a1a" />
  <CornerRadius x:Key="ToolTipCornerRadius">6</CornerRadius>

  <!-- Study Cafe Phase accent colors -->
  <SolidColorBrush x:Key="PhaseFocusBrush" Color="#A65340" />
  <SolidColorBrush x:Key="PhaseBreakBrush" Color="#3B7D64" />
  <SolidColorBrush x:Key="PhaseIdleBrush" Color="#6E6E73" />

  <!-- Context menu tokens adapted from EverythingToolbar Win11 Light -->
  <SolidColorBrush x:Key="ContextMenuBackground" Color="#F3F3F3" />
  <SolidColorBrush x:Key="ContextMenuBorder" Color="#C2C2C2" />
  <SolidColorBrush x:Key="ContextMenuSeparator" Color="#C2C2C2" />
  <SolidColorBrush x:Key="ContextMenuItemBackgroundHover" Color="#DBDBDB" />
  <SolidColorBrush x:Key="ContextMenuItemForeground" Color="#1A1A1A" />
  <SolidColorBrush x:Key="ContextMenuItemForegroundHover" Color="#000000" />
  <CornerRadius x:Key="ContextMenuCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ContextMenuMenuItemCornerRadius">5</CornerRadius>
</ResourceDictionary>
